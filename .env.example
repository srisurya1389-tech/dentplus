# Copy to .env.local for `vercel dev`. On Vercel, set these in Project → Settings → Environment Variables.
# Added automatically when you connect Upstash Redis from Vercel → Storage:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Admin panel password (at least 10 characters, use a strong one):
ADMIN_PASSWORD=
# Optional: random string used to sign admin sessions (changing it logs everyone out):
ADMIN_SECRET=
